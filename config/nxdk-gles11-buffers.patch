+
+GL_API void *GL_APIENTRY glMapBufferOES(GLenum target, GLenum access)
+{
+    GLuint *binding = get_binding_ptr(target);
+    if (!binding || access != GL_WRITE_ONLY_OES) {
+        gliSetError(GL_INVALID_ENUM);
+        return NULL;
+    }
+    buffer_object_t *buffer = gliFindBufferObject(*binding, NULL);
+    if (!buffer || buffer->mapped) {
+        gliSetError(GL_INVALID_OPERATION);
+        return NULL;
+    }
+    // Mapping permits overwriting old bytes, so previous GPU reads must finish.
+    if (buffer->gpu_used) {
+        while (pb_busy()) {
+            NtYieldExecution();
+        }
+        buffer->gpu_used = GL_FALSE;
+    }
+    buffer->mapped = GL_TRUE;
+    return buffer->buffer_data;
+}
+
+GL_API GLboolean GL_APIENTRY glUnmapBufferOES(GLenum target)
+{
+    GLuint *binding = get_binding_ptr(target);
+    if (!binding) {
+        gliSetError(GL_INVALID_ENUM);
+        return GL_FALSE;
+    }
+    buffer_object_t *buffer = gliFindBufferObject(*binding, NULL);
+    if (!buffer || !buffer->mapped) {
+        gliSetError(GL_INVALID_OPERATION);
+        return GL_FALSE;
+    }
+    // The stock Xbox supports SSE1: SFENCE publishes write-combined CPU stores.
+    __asm__ volatile("sfence" ::: "memory");
+    buffer->mapped = GL_FALSE;
+    uint32_t *pb = pb_begin();
+    pb = pb_push1(pb, NV097_BREAK_VERTEX_BUFFER_CACHE, 0);
+    pb_end(pb);
+    return GL_TRUE;
+}
+
+GL_API void GL_APIENTRY glGetBufferPointervOES(GLenum target, GLenum pname, void **params)
+{
+    GLuint *binding = get_binding_ptr(target);
+    if (!binding || pname != GL_BUFFER_MAP_POINTER_OES) {
+        gliSetError(GL_INVALID_ENUM);
+        return;
+    }
+    buffer_object_t *buffer = gliFindBufferObject(*binding, NULL);
+    if (!buffer) {
+        gliSetError(GL_INVALID_OPERATION);
+        return;
+    }
+    *params = buffer->mapped ? buffer->buffer_data : NULL;
+}

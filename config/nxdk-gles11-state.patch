+static GLboolean combiner_state_unchanged(gli_context_t *context)
+{
+    combiner_state_t state = {0};
+    texture_environment_t *env = &context->texture_environment;
+    for (GLuint i = 0; i < GLI_MAX_TEXTURE_UNITS; ++i) {
+        const texture_unit_t *unit = &env->texture_units[i];
+        state.active[i] = unit->texture_2d_enabled && unit->bound_texture_object &&
+            unit->bound_texture_object != &unit->unbound_texture_object &&
+            gliTextureObjectIsComplete(unit->bound_texture_object);
+        memcpy(state.environment[i], &unit->tex_env_mode, GLI_COMBINER_ENV_BYTES);
+    }
+    for (GLuint i = 0; i < GLI_MAX_CLIP_PLANES; ++i) {
+        state.clip[i] = context->transformation_state.clip_plane_enabled[i];
+        // The clipping path also uploads plane equations and consumes dirty state.
+        // Let it run whenever enabled, including coefficient-only changes.
+        if (state.clip[i]) {
+            env->combiner_state_valid = GL_FALSE;
+            return GL_FALSE;
+        }
+    }
+    state.point_sprite = context->rasterization_state.point_sprite_oes_enabled;
+    state.fog = context->coloring_state.fog_enabled;
+    state.lighting = context->lighting_state.lighting_enabled;
+    if (env->combiner_state_valid && !memcmp(&state, &env->combiner_state, sizeof(state)))
+        return GL_TRUE;
+    env->combiner_state = state;
+    env->combiner_state_valid = GL_TRUE;
+    return GL_FALSE;
+}
